{
  "name": "system-monitoring",
  "version": "0.1.0",
  "description": "Zero-runtime-dependency Node.js metrics with bounded collection and optional Express middleware",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "jest --config=jest.config.js",
    "format": "prettier --write src test scripts README.md MIGRATION.md package.json .github/workflows/*.yaml",
    "check:package": "node scripts/check-package.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "prepack": "npm run build",
    "check": "npm run lint && npm run build && npm test -- --runInBand && npm run check:package",
    "docs": "typedoc --options typedoc.json"
  },
  "keywords": [
    "monitoring",
    "server",
    "system",
    "monitor",
    "system-monitor",
    "performance-monitoring",
    "cpu-usage",
    "memory-usage",
    "disk-usage",
    "network-monitoring",
    "uptime-monitor",
    "process-info",
    "temperature-monitor",
    "nodejs-monitoring",
    "server-monitor",
    "system-metrics",
    "logging",
    "express-middleware",
    "system-health"
  ],
  "author": "Milad E Fahmy<miladezzat.f@gmail.com>",
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "express": "^4.22.3",
    "express5": "npm:express@^5.1.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miladezzat/system-monitoring"
  },
  "bugs": {
    "url": "https://github.com/miladezzat/system-monitoring/issues"
  },
  "homepage": "https://github.com/miladezzat/system-monitoring",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js",
      "require": "./dist/express/index.js"
    },
    "./package.json": "./package.json"
  }
}
